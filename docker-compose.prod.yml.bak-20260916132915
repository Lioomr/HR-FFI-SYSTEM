services:
  db:
    image: postgres:16-alpine
    container_name: ffi_hr_db_prod
    restart: always
    env_file:
      - ./Backend/.env.production
    environment:
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - postgres_data_prod:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER} -d ${DB_NAME}"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build:
      context: ./Backend
    container_name: ffi_hr_backend_prod
    restart: always
    env_file:
      - ./Backend/.env.production
    environment:
      DB_ENGINE: django.db.backends.postgresql
      DB_HOST: db
      DB_PORT: 5432
      HR_TEMPLATES_DIR: /hr/templates
      REDIS_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/2
      CELERY_RESULT_BACKEND: redis://redis:6379/3
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    ports:
      - "8000:8000"
    volumes:
      - /hr/templates:/hr/templates:ro
      - private_uploads_prod:/app/private_uploads
    healthcheck:
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('127.0.0.1', 8000), 3).close()"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 30s

  redis:
    image: redis:7-alpine
    container_name: ffi_hr_redis_prod
    restart: always
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis_data_prod:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  notification-worker:
    build:
      context: ./Backend
    container_name: ffi_hr_notification_worker_prod
    restart: always
    user: app
    env_file:
      - ./Backend/.env.production
    environment:
      DB_ENGINE: django.db.backends.postgresql
      DB_HOST: db
      DB_PORT: 5432
      REDIS_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/2
      CELERY_RESULT_BACKEND: redis://redis:6379/3
    command: ["celery", "-A", "config", "worker", "--loglevel=INFO"]
    volumes:
      - private_uploads_prod:/app/private_uploads
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      backend:
        condition: service_healthy
      evolution-api:
        condition: service_started

  notification-beat:
    build:
      context: ./Backend
    container_name: ffi_hr_notification_beat_prod
    restart: always
    user: app
    env_file:
      - ./Backend/.env.production
    environment:
      DB_ENGINE: django.db.backends.postgresql
      DB_HOST: db
      DB_PORT: 5432
      REDIS_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/2
      CELERY_RESULT_BACKEND: redis://redis:6379/3
    command: ["celery", "-A", "config", "beat", "--loglevel=INFO", "--schedule=/tmp/celerybeat-schedule"]
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      backend:
        condition: service_healthy

  evolution-db:
    image: postgres:16-alpine
    container_name: ffi_hr_evolution_db_prod
    restart: always
    environment:
      POSTGRES_DB: evolution
      POSTGRES_USER: evolution
      POSTGRES_PASSWORD: ${EVOLUTION_DB_PASSWORD}
    volumes:
      - evolution_postgres_data_prod:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U evolution -d evolution"]
      interval: 10s
      timeout: 5s
      retries: 5

  evolution-redis:
    image: redis:7-alpine
    container_name: ffi_hr_evolution_redis_prod
    restart: always
    volumes:
      - evolution_redis_data_prod:/data

  evolution-api:
    image: evoapicloud/evolution-api:latest
    container_name: ffi_hr_evolution_api_prod
    restart: always
    environment:
      AUTHENTICATION_API_KEY: ${EVOLUTION_API_KEY}
      DEL_INSTANCE_ON_DISCONNECT: "false"
      QRCODE_LIMIT: "30"
      CONFIG_SESSION_PHONE_CLIENT: Evolution API
      CONFIG_SESSION_PHONE_NAME: Chrome
      CONFIG_SESSION_PHONE_VERSION: 2.3000.1042894117
      WEB_VERSION: 2.3000.1042894117
      DATABASE_ENABLED: "true"
      DATABASE_PROVIDER: postgresql
      DATABASE_CONNECTION_URI: postgresql://evolution:${EVOLUTION_DB_PASSWORD}@evolution-db:5432/evolution
      CACHE_REDIS_ENABLED: "true"
      CACHE_REDIS_URI: redis://evolution-redis:6379/0
      SERVER_URL: http://13.51.209.116:8081
    volumes:
      - evolution_store_prod:/evolution/store
      - evolution_instances_prod:/evolution/instances
    depends_on:
      evolution-db:
        condition: service_healthy
      evolution-redis:
        condition: service_started
    ports:
      - "8081:8080"

  frontend:
    build:
      context: ./FrontEnd
      args:
        VITE_API_BASE_URL: ""
    container_name: ffi_hr_frontend_prod
    restart: always
    depends_on:
      - backend
    ports:
      - "8080:80"

volumes:
  postgres_data_prod:
  redis_data_prod:
  private_uploads_prod:
  evolution_postgres_data_prod:
  evolution_redis_data_prod:
  evolution_store_prod:
  evolution_instances_prod:
