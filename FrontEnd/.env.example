# Frontend environment template. Copy to `.env` (which is gitignored) and edit.
# Never commit real credentials, API keys, or provider secrets.

# Base URL for the backend API. Empty keeps requests same-origin, which is what
# the Docker Nginx proxy expects.
VITE_API_BASE_URL=

# Work Location map picker tiles.
#
# Both are optional. Left unset, the app falls back to keyless OpenStreetMap
# tiles with the attribution OSM's usage policy requires — fine for local
# development, NOT suitable for production traffic (see the OSM Tile Usage
# Policy). For production, point these at your own tile provider.
#
# If your provider needs an access token, embed it in the URL here in your own
# `.env` only. Note that any browser-delivered tile key is visible to users, so
# use a provider key that is domain-restricted.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
