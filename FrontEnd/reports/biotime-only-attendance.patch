+      "/api/attendance/me/",
+      "/api/attendance/",
+      "/api/ceo/attendance/",
+      "/api/manager/attendance/",
+    ]);
+    expect(api.post).not.toHaveBeenCalled();
+    expect(api.patch).not.toHaveBeenCalled();
+    expect(api.delete).not.toHaveBeenCalled();
+    expect(Object.keys(attendance).sort()).toEqual([
+      "getCEOAttendance",
+      "getGlobalAttendance",
+      "getMyAttendance",
+    ]);
+  });
+});
