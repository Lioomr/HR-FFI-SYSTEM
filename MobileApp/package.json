{
  "name": "ffi-hr-employee-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.7",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:test": "FFI_APP_ENV=test EXPO_PUBLIC_API_BASE_URL=http://localhost:8000 expo start --clear",
    "android": "expo run:android",
    "android:test": "FFI_APP_ENV=test EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000 expo start --android --clear",
    "ios": "expo run:ios",
    "ios:test": "FFI_APP_ENV=test EXPO_PUBLIC_API_BASE_URL=http://localhost:8000 expo start --ios --clear",
    "web": "expo start --web",
    "web:test": "FFI_APP_ENV=test EXPO_PUBLIC_API_BASE_URL=http://localhost:8000 expo start --web --clear",
    "type-check": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  },
  "private": true,
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5"
  }
}
