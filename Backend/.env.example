DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ffi_hr_db
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=https://your-frontend-domain.com
BACKEND_PUBLIC_URL=https://your-api-domain.com
EMAIL_DISPLAY_TIME_ZONE=Asia/Riyadh
DEFAULT_FROM_EMAIL=no-reply@fficontracting.com
NOTIFICATION_HTTP_TIMEOUT_SECONDS=10
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
NOTIFICATION_WHATSAPP_DELIVERY_ENABLED=true
NOTIFICATION_EMAIL_FALLBACK_ENABLED=true
NOTIFICATION_DELIVERY_MAX_RETRIES=3
NOTIFICATION_DELIVERY_RETRY_BACKOFF_SECONDS=2
# Optional error monitoring. Keep sampling at zero until traces/profiles are
# intentionally enabled and reviewed for the production data policy.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
# Optional Celery Beat heartbeat. Treat the URL as a secret and leave blank to disable.
HEALTHCHECKS_PING_URL=
HEALTHCHECKS_PING_TIMEOUT_SECONDS=10
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
COGNEE_ENABLED=false
COGNEE_BASE_URL=http://localhost:8001
COGNEE_API_KEY=
COGNEE_TIMEOUT_SECONDS=10
COGNEE_ADD_PATH=/api/v1/add
COGNEE_SEARCH_PATH=/api/v1/search
COGNEE_HEALTH_PATH=/health
CELERY_TASK_ALWAYS_EAGER=false
EMPLOYEE_DOCUMENT_OCR_TIMEOUT_SECONDS=20
EMPLOYEE_DOCUMENT_OCR_MAX_PAGES=3
EMPLOYEE_DOCUMENT_OCR_MAX_IMAGE_DIMENSION=3000
# Self-hosted PaddleOCR. Models are provisioned into this directory at image
# build time (or once via: python manage.py provision_ocr_models). The worker
# must not download models at runtime.
EMPLOYEE_DOCUMENT_OCR_MODEL_DIR=/opt/paddleocr
EMPLOYEE_DOCUMENT_OCR_ALLOW_MODEL_DOWNLOAD=false
EMPLOYEE_DOCUMENT_OCR_MIN_CONFIDENCE=0.6
EMPLOYEE_DOCUMENT_OCR_CPU_THREADS=2
EMPLOYEE_DOCUMENT_OCR_PDF_RENDER_SCALE=2.5
EMPLOYEE_DOCUMENT_OCR_SOFT_TIME_LIMIT_SECONDS=240
EMPLOYEE_DOCUMENT_OCR_TIME_LIMIT_SECONDS=300
EMPLOYEE_DOCUMENT_OCR_MAX_RETRIES=3
EMPLOYEE_DOCUMENT_OCR_QUEUE_LEASE_SECONDS=900
# Bilingual OCR: English pass reads Latin fields, Arabic pass reads Arabic script;
# results are merged by bounding-box overlap.
EMPLOYEE_DOCUMENT_OCR_BILINGUAL_LANGUAGES=en,ar
EMPLOYEE_DOCUMENT_OCR_MERGE_OVERLAP=0.6
EMPLOYEE_DOCUMENT_OCR_MIN_PAGE_CHARACTERS=24
# Grace period before an interrupted document deletion is reconciled.
EMPLOYEE_DOCUMENT_DELETION_RECONCILE_GRACE_SECONDS=300
NOTIFICATION_WORKER_READINESS_TIMEOUT_SECONDS=60
NOTIFICATION_WORKER_READINESS_INTERVAL_SECONDS=2
NOTIFICATION_WORKER_READINESS_REQUEST_TIMEOUT_SECONDS=5
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_CLEANUP_HOUR=2
NOTIFICATION_CLEANUP_MINUTE=0

MESSAGING_SMS_PROVIDER=textbee

BIRD_API_KEY=
BIRD_CHANNEL_ID=
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
BIRD_EMAIL_CHANNEL_ID=
BIRD_API_BASE_URL=https://api.bird.com/workspaces

EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

TEXTBEE_API_BASE_URL=https://api.textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_REFERRER_POLICY=same-origin

# /healthz/ returns a liveness-only result to anonymous callers. Set a token to let
# infrastructure readiness probes fetch full dependency diagnostics by sending it in
# the X-Health-Token header; admin users always see the diagnostics.
HEALTH_CHECK_TOKEN=
HEALTH_CHECK_CACHE_SECONDS=15

# Frontend crash reports (POST /api/core/report-error/) are emailed here and are
# rate limited per client because the endpoint is public.
ADMIN_ERROR_REPORT_EMAIL=
ERROR_REPORT_THROTTLE_RATE=5/min
