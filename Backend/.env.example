DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ffi_hr_db
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=https://your-frontend-domain.com
BACKEND_PUBLIC_URL=https://your-api-domain.com
EMAIL_DISPLAY_TIME_ZONE=Asia/Riyadh
DEFAULT_FROM_EMAIL=no-reply@fficontracting.com
NOTIFICATION_HTTP_TIMEOUT_SECONDS=10
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
NOTIFICATION_WHATSAPP_DELIVERY_ENABLED=true
NOTIFICATION_EMAIL_FALLBACK_ENABLED=true
NOTIFICATION_DELIVERY_MAX_RETRIES=3
NOTIFICATION_DELIVERY_RETRY_BACKOFF_SECONDS=2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_ALWAYS_EAGER=false
NOTIFICATION_WORKER_READINESS_TIMEOUT_SECONDS=60
NOTIFICATION_WORKER_READINESS_INTERVAL_SECONDS=2
NOTIFICATION_WORKER_READINESS_REQUEST_TIMEOUT_SECONDS=5
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_CLEANUP_HOUR=2
NOTIFICATION_CLEANUP_MINUTE=0

MESSAGING_SMS_PROVIDER=textbee

BIRD_API_KEY=
BIRD_CHANNEL_ID=
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
BIRD_EMAIL_CHANNEL_ID=
BIRD_API_BASE_URL=https://api.bird.com/workspaces

EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

TEXTBEE_API_BASE_URL=https://api.textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_REFERRER_POLICY=same-origin
