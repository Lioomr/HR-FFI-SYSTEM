DJANGO_DEBUG=true
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
EMAIL_DISPLAY_TIME_ZONE=Asia/Riyadh

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ffi_hr_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

DEFAULT_FROM_EMAIL=no-reply@fficontracting.com
EMAIL_LOGO_PATH=/app/static/email/ffi-logo.png
EMAIL_LOGO_URL=
EMAIL_CONTACT_EMAIL=hr@fficontracting.com
NOTIFICATION_HTTP_TIMEOUT_SECONDS=10
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
NOTIFICATION_WHATSAPP_DELIVERY_ENABLED=true
NOTIFICATION_EMAIL_FALLBACK_ENABLED=true
NOTIFICATION_DELIVERY_MAX_RETRIES=3
NOTIFICATION_DELIVERY_RETRY_BACKOFF_SECONDS=2
# Optional error monitoring. Empty SENTRY_DSN keeps the integration disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
# Optional Celery Beat heartbeat. Treat the URL as a secret and leave blank to disable.
HEALTHCHECKS_PING_URL=
HEALTHCHECKS_PING_TIMEOUT_SECONDS=10
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_TASK_ALWAYS_EAGER=false
EMPLOYEE_DOCUMENT_OCR_TIMEOUT_SECONDS=20
EMPLOYEE_DOCUMENT_OCR_MAX_PAGES=3
EMPLOYEE_DOCUMENT_OCR_MAX_IMAGE_DIMENSION=3000
# Self-hosted PaddleOCR. Models are provisioned into this directory at image
# build time (or once via: python manage.py provision_ocr_models). The worker
# must not download models at runtime.
EMPLOYEE_DOCUMENT_OCR_MODEL_DIR=/opt/paddleocr
EMPLOYEE_DOCUMENT_OCR_ALLOW_MODEL_DOWNLOAD=false
EMPLOYEE_DOCUMENT_OCR_MIN_CONFIDENCE=0.6
EMPLOYEE_DOCUMENT_OCR_CPU_THREADS=2
EMPLOYEE_DOCUMENT_OCR_PDF_RENDER_SCALE=2.5
EMPLOYEE_DOCUMENT_OCR_SOFT_TIME_LIMIT_SECONDS=240
EMPLOYEE_DOCUMENT_OCR_TIME_LIMIT_SECONDS=300
EMPLOYEE_DOCUMENT_OCR_MAX_RETRIES=3
EMPLOYEE_DOCUMENT_OCR_QUEUE_LEASE_SECONDS=900
# Bilingual OCR: English pass reads Latin fields, Arabic pass reads Arabic script;
# results are merged by bounding-box overlap.
EMPLOYEE_DOCUMENT_OCR_BILINGUAL_LANGUAGES=en,ar
EMPLOYEE_DOCUMENT_OCR_MERGE_OVERLAP=0.6
EMPLOYEE_DOCUMENT_OCR_MIN_PAGE_CHARACTERS=24
# Grace period before an interrupted document deletion is reconciled.
EMPLOYEE_DOCUMENT_DELETION_RECONCILE_GRACE_SECONDS=300
NOTIFICATION_WORKER_READINESS_TIMEOUT_SECONDS=60
NOTIFICATION_WORKER_READINESS_INTERVAL_SECONDS=2
NOTIFICATION_WORKER_READINESS_REQUEST_TIMEOUT_SECONDS=5
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_CLEANUP_HOUR=2
NOTIFICATION_CLEANUP_MINUTE=0

BIRD_API_KEY=replace-me
BIRD_CHANNEL_ID=replace-me
BIRD_WORKSPACE_ID=replace-me

HEALTH_CHECK_TOKEN=replace-me
HEALTH_CHECK_CACHE_SECONDS=15
ADMIN_ERROR_REPORT_EMAIL=replace-me
ERROR_REPORT_THROTTLE_RATE=5/min
