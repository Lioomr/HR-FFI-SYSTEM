# Generate unique values on the staging server. Never commit .env.staging.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-64-character-secret
DJANGO_ALLOWED_HOSTS=api-mobile-dev.asecopro.com
BACKEND_PUBLIC_URL=https://api-mobile-dev.asecopro.com
FRONTEND_URL=https://app.asecopro.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

DB_NAME=ffi_hr_mobile_staging
DB_USER=ffi_hr_mobile_staging
DB_PASSWORD=replace-with-a-random-database-password

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_REFERRER_POLICY=same-origin

# Staging must not send real email, SMS, or WhatsApp notifications.
NOTIFICATION_WHATSAPP_DELIVERY_ENABLED=false
NOTIFICATION_EMAIL_FALLBACK_ENABLED=false
MESSAGING_SMS_PROVIDER=disabled
